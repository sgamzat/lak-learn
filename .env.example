# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=lak_learn
POSTGRES_USER=lak_user
# Обязательно. Сгенерируйте: openssl rand -base64 24
POSTGRES_PASSWORD=
# Для `npm run dev` вне Docker (Postgres поднят через docker-compose.dev.yml)
DATABASE_URL=postgresql://lak_user:ПАРОЛЬ@localhost:5432/lak_learn
# Размер пула соединений на один процесс приложения
DB_POOL_MAX=10

# ── Auth JWT ─────────────────────────────────────────────────
# Обязательно, минимум 32 символа, разные для access и refresh.
# Приложение откажется работать с заглушками вида change_me_*.
# Сгенерируйте каждый: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Для браузера обычно пусто, когда фронт и API идут через один origin (Nginx)
NEXT_PUBLIC_API_BASE_URL=

# ── Миграции ─────────────────────────────────────────────────
# Локально: PGPASSWORD=$POSTGRES_PASSWORD npm run db:migrate
# В Docker: docker compose run --rm migrate
#
# ── Первый администратор ─────────────────────────────────────
# Создаётся скриптом, пароль не хранится в репозитории:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='...' npm run admin:create
# В Docker:
#   docker compose exec -e ADMIN_EMAIL=... -e ADMIN_PASSWORD='...' app node scripts/create-admin.mjs
