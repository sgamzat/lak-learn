# PostgreSQL
POSTGRES_DB=lak_learn
POSTGRES_USER=lak_user
POSTGRES_PASSWORD=lak_password
DATABASE_URL=postgresql://lak_user:lak_password@localhost:5432/lak_learn

# Auth JWT (обязательно смените в проде)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Для браузера обычно пусто, когда фронт и API идут через один origin (Nginx)
NEXT_PUBLIC_API_BASE_URL=

# Миграции локально: PGPASSWORD=$POSTGRES_PASSWORD npm run db:migrate
# Или: docker compose run --rm migrate
#
# Стартовый админ (миграция 009_seed_admin.sql):
#   email:    admin@laklearn.local
#   password: Admin123!
# В проде сразу смените пароль.