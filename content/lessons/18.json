    },
    {
      "type": "text",
      "title": "Цвета",
      "sentences": [
        {
          "lak": "Велосипедистнай хъахъисса майка бур.",
          "ru": "На велосипедисте жёлтая майка."
        },
        {
          "lak": "Зунттаву ссав някӀсса дикӀай.",
          "ru": "В горах небо синее."
        },
        {
          "lak": "ЯтӀулсса тӀутӀи ххярххун дур.",
          "ru": "Вырос красный цветок."
        },
        {
          "lak": "Хъахъисса, ятӀулсса, някӀсса – вай агьамми рангрури.",
          "ru": "Жёлтый, красный, синий — основные цвета."
        },
        {
          "lak": "Агьамми рангирдая гайми рангру дан шайссар.",
          "ru": "Из основных цветов можно получить другие."
        },
        {
          "lak": "Хъахъиссагу, някӀссагу рангру хӀала дарча, щюллисса ранг шайссар.",
          "ru": "Если смешать жёлтый и синий, получится зелёный."
        },
        {
          "lak": "Щюллисса урттул щюлли дурну дур дуниял.",
          "ru": "Зелёная трава сделала мир зелёным."
        }
      ]
    },
    {
