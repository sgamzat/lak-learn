    {
      "type": "dialogue",
      "title": "Концерт",
      "lines": [
        {
          "who": "Шуанат",
          "lak": "Алло?"
        },
        {
          "who": "Зайнутин",
          "lak": "Бивзрав, Шуаьнат!",
          "ru": "Доброе утро, Шуанат!"
        },
        {
          "who": "Шуанат",
          "lak": "Зайнутин урав? Ивзрав инагу!",
          "ru": "Это Зайнутин? И тебе доброе утро!"
        },
        {
          "who": "Зайнутин",
          "lak": "Шуаьнат, хӀакьину жулла дарс дикӀантӀиссаривкьай?",
          "ru": "Шуанат, у нас сегодня будет урок?"
        },
        {
          "who": "Шуанат",
          "lak": "Зайнутин, хӀакьину жу концертрайн най буру.",
          "ru": "Зайнутин, сегодня мы идём на концерт."
        },
        {
          "who": "Зайнутин",
          "lak": "Ци концерт дурар?",
          "ru": "А что за концерт?"
        },
        {
          "who": "Шуанат",
          "lak": "Лакку балайрдал концерт дур.",
          "ru": "Концерт лакских песен."
        },
        {
          "who": "Зайнутин",
          "lak": "Щищал най бурар концертрайн?",
          "ru": "С кем идёшь на концерт?"
        },
        {
          "who": "Шуанат",
          "lak": "Щала кулпат най буру.",
          "ru": "Идём всей семьёй."
        },
        {
          "who": "Зайнутин",
          "lak": "Цу урар концертрай балай тӀий?",
          "ru": "А кто будет петь?"
        },
        {
          "who": "Шуанат",
          "lak": "Ххуй-ххуйсса лакку балайчитал бур.",
          "ru": "Очень хорошие лакские певцы."
        },
        {
          "who": "Зайнутин",
          "lak": "Туну та дикӀантӀиссарар жулла дарс?",
          "ru": "Тогда когда же будет наш урок?"
        },
        {
          "who": "Шуанат",
          "lak": "Гьунттий.",
          "ru": "Завтра."
        },
        {
          "who": "Зайнутин",
          "lak": "Хъинни. Барчаллагь.",
          "ru": "Хорошо. До свидания."
        }
      ]
    },
    {
      "type": "rule",
      "title": "-ар: живой интерес",
      "text": "Частица **-ар** в разговоре придаёт вопросу живость, смысл не меняется: **Щищал най бура?** → **Щищал най бурар?** — «А с кем идёшь-то?»"
    },
    {
      "type": "text",
      "title": "«Обманчивая любовь»",
      "sentences": [
        {
          "lak": "Гъумучи шяравалур.",
          "ru": "Кумух — селение."
        },
        {
          "lak": "Гъумучи буссар Лаккуй.",
          "ru": "Кумух находится в Лакии."
        },
        {
          "lak": "«Хъявринсса ччаву»лий хъанахъимур бавхӀуну бур ГъумучияцӀун.",
          "ru": "События «Обманчивой любви» связаны с Кумухом."
        },
        {
          "lak": "Ва бур Ибрагьиннул ва Бахул ччавриясса хавар.",
          "ru": "Это история любви Ибрагима и Баху."
        },
        {
          "lak": "Вайннал талихӀ къавхьуссар.",
          "ru": "Им не выпало счастья."
        },
        {
          "lak": "Ва ччаврил ахир кьурчӀисса хьуссар.",
          "ru": "Конец этой любви оказался горьким."
        }
      ]
    },
    {
      "type": "rule",
      "title": "-цӀун: «связано с», и хьун / хъанан",
      "text": "**-цӀун** — связь с чем-то: **ГъумучияцӀун** — с Кумухом, **шяраваллицӀун** — с селением.\n\n**хьун** — стать, случиться (один раз), **хъанан** — становиться, происходить (процесс). Отсюда **хьумур** — то, что случилось, и **хъанахъимур** — то, что происходит."
    },
