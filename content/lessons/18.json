    {
      "type": "text",
      "title": "Дорога",
      "sentences": [
        {
          "lak": "Ва ххуллур.",
          "ru": "Это дорога."
        },
        {
          "lak": "Ва кӀюласса ххуллу бур.",
          "ru": "Это узкая дорога."
        },
        {
          "lak": "КӀюласса ххуллийн жегъирххуллу учайссар.",
          "ru": "Узкую дорогу называют «жегъирххуллу»."
        },
        {
          "lak": "Ва уттасса ххуллу бур.",
          "ru": "Это широкая дорога."
        },
        {
          "lak": "Уттасса ххуллийн шагьраххуллу учайссар.",
          "ru": "Широкую дорогу называют «шагьраххуллу»."
        },
        {
          "lak": "Ванийх къир бавкьуну бур.",
          "ru": "Она покрыта асфальтом."
        },
        {
          "lak": "Къир бавкьусса ххуллу саргъунсса ва бювчӀусса бикӀайссар.",
          "ru": "Асфальтированная дорога ровная и гладкая."
        }
      ]
    },
    {
      "type": "text",
      "title": "Улица",
      "sentences": [
        {
          "lak": "Ва шагьрулийсса кӀичӀиравалу бур.",
          "ru": "Это городская улица."
        },
        {
          "lak": "Шагьрулийсса ххуллул кӀива бутӀа бикӀайссар.",
          "ru": "У городской дороги две части."
        },
        {
          "lak": "Ца бутӀа дяних. Ганийх машинартту бачайссар.",
          "ru": "Одна часть — посередине. По ней ездят машины."
        },
        {
          "lak": "Мунияту ганийн машинарттал чул ягу машинчул учайссар.",
          "ru": "Поэтому её называют проезжей частью."
        },
        {
          "lak": "Вамур чулийн тротуар учайссар.",
          "ru": "Другую часть называют тротуаром."
        },
        {
          "lak": "Тротуарданийх бахьттагьалт бачайссар.",
          "ru": "По тротуару ходят пешеходы."
        }
      ]
    },
    {
      "type": "choice",
      "prompt": "Как называют узкую дорогу, тропинку?",
      "options": [
        "жегъирххуллу",
        "шагьраххуллу",
        "машинчул"
      ],
      "answer": 0
    },
    {
      "type": "rule",
      "title": "-ийх: «по»",
      "text": "**-ийх**, **-ух** — движение по поверхности: **ххуллийх** — по дороге, **тротуарданийх** — по тротуару, **кӀичӀиравух** — по улице.",
      "examples": [
        {
          "lak": "Тротуарданийх бахьттагьалт бачайссар.",
