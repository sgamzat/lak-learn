        {
          "lak": "Интту дуниял гъили шайссар.",
          "ru": "Весной становится тепло (букв. мир становится тёплым)."
        },
        {
          "lak": "Интнил гьантрай уртту-тӀутӀив ххяххайссар.",
          "ru": "Весенними днями растут трава и цветы."
        },
        {
          "lak": "Интту дуниял щюлли шайссар.",
          "ru": "Весной всё зеленеет (букв. мир становится зелёным)."
        },
        {
          "lak": "Июньдалий инт къуртал шайссар, дайдишайссар гъи.",
          "ru": "В июне весна кончается и начинается лето."
        }
