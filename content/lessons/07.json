    {
      "type": "text",
      "title": "Дагестан",
      "sentences": [
        {
          "lak": "Ва Дагъусттанни.",
          "ru": "Это Дагестан."
        },
        {
          "lak": "Дагъусттан билаятри.",
          "ru": "Дагестан — страна."
        },
        {
          "lak": "Ва Каспи хьхьирир.",
          "ru": "Это Каспийское море."
        },
        {
          "lak": "Дагъусттан Аьрасатнал бутӀар.",
          "ru": "Дагестан — часть России."
        },
        {
          "lak": "Дагъусттан Европаналгу, Азияналгу дазуй буссар.",
          "ru": "Дагестан находится на границе Европы и Азии."
