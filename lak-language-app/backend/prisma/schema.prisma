# Prisma schema for Lak Language Learning App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User Models
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  avatar    String?
  role      UserRole @default(USER)
  level     Int      @default(1)
  xp        Int      @default(0)
  streak    Int      @default(0)
  lastActivity DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  progress     UserWordProgress[]
  achievements UserAchievement[]
  sentenceProgress UserSentenceProgress[]
  
  @@index([email])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

// ============================================
// Word Models
// ============================================

model Word {
  id              String   @id @default(uuid())
  lakWord         String
  translation     String
  transcription   String?
  partOfSpeech    String?
  topic           String
  exampleSentence String?
  difficulty      Int      @default(1) // 1-5 scale
  audioUrl        String?
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  sentences       SentenceWord[]
  progress        UserWordProgress[]
  
  @@index([topic])
  @@index([difficulty])
  @@index([lakWord])
  @@map("words")
}

// ============================================
// Sentence Models
// ============================================

model Sentence {
  id          String   @id @default(uuid())
  lakText     String
  translation String
  difficulty  Int      @default(1) // 1-5 scale
  topic       String?
  audioUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  words       SentenceWord[]
  progress    UserSentenceProgress[]
  
  @@index([difficulty])
  @@index([topic])
  @@map("sentences")
}

model SentenceWord {
  id         String   @id @default(uuid())
  sentenceId String
  wordId     String
  position   Int
  
  sentence   Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  
  @@unique([sentenceId, wordId])
  @@index([sentenceId])
  @@index([wordId])
  @@map("sentence_words")
}

// ============================================
// Progress Models (Spaced Repetition System)
// ============================================

model UserWordProgress {
  id            String   @id @default(uuid())
  userId        String
  wordId        String
  known         Boolean  @default(false)
  repeats       Int      @default(0)
  easeFactor    Float    @default(2.5) // SRS ease factor
  interval      Int      @default(0)   // Days until next review
  nextReview    DateTime
  lastPracticed DateTime?
  correctCount  Int      @default(0)
  incorrectCount Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          Word     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word          Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  
  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
  @@index([nextReview])
  @@map("user_word_progress")
}

model UserSentenceProgress {
  id            String   @id @default(uuid())
  userId        String
  sentenceId    String
  known         Boolean  @default(false)
  repeats       Int      @default(0)
  easeFactor    Float    @default(2.5)
  interval      Int      @default(0)
  nextReview    DateTime
  lastPracticed DateTime?
  correctCount  Int      @default(0)
  incorrectCount Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentence      Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  
  @@unique([userId, sentenceId])
  @@index([userId])
  @@index([sentenceId])
  @@index([nextReview])
  @@map("user_sentence_progress")
}

// ============================================
// Achievement Models
// ============================================

model Achievement {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  icon        String?
  requirement Int      // XP threshold or count
  type        AchievementType
  createdAt   DateTime @default(now())
  
  users       UserAchievement[]
  
  @@map("achievements")
}

enum AchievementType {
  XP_THRESHOLD
  STREAK
  WORDS_LEARNED
  SENTENCES_LEARNED
  PERFECT_WEEK
  EARLY_BIRD
  NIGHT_OWL
}

model UserAchievement {
  id             String      @id @default(uuid())
  userId         String
  achievementId  String
  unlockedAt     DateTime    @default(now())
  
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement    Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// ============================================
// Activity Log (for analytics)
// ============================================

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entityType String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}
